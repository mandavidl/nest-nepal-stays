# Example environment configuration — PLACEHOLDERS ONLY.
# Never commit real secret values. Configure real values as backend
# environment secrets (Lovable Cloud project secrets), not in this file.

# WhatsApp Business (Meta Cloud API) — SERVER-SIDE ONLY.
# These are read only inside server functions and must never be exposed to the
# browser, a VITE_ variable, or a frontend build (e.g. GitHub Pages).
WHATSAPP_ACCESS_TOKEN=your_secret_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_RECIPIENT_PHONE=9761715925

# Public (safe to expose) frontend values are provided by the platform:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
